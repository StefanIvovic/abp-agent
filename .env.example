# Copy to .env and fill in. .env is gitignored.
# Hostnames for services inside Docker are set in compose.yaml; only credentials and choices live here.

# Postgres (ParadeDB)
POSTGRES_USER=abp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abp

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-8chars-min

# LLM: any OpenAI-compatible server with tool calling. Default: LM Studio on the host.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=not-needed

# Embeddings: bge-m3 in LM Studio, loaded once on the CPU, never on demand:
#   lms load text-embedding-bge-m3 --gpu off -c 2048
EMBED_BASE_URL=http://host.docker.internal:1234/v1
EMBED_MODEL=text-embedding-bge-m3

# Local clone of https://github.com/abpframework/abp (mounted read-only)
ABP_REPO_DIR=../../Csharp/abp

# MCP server: clients send this as a bearer token. Empty means nobody gets in.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=
